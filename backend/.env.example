# ── Backend Environment Variables ───────────────────────────────────
# Salin file ini ke ".env" di folder backend/ dan isi nilainya.

# Database PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=investasi_jatim
DB_USER=postgres
DB_PASS=ganti_password_ini

# CORS — URL frontend yang boleh akses API
# Development: http://localhost:5173
# Production: https://dashboard.dpmptsp-jatim.go.id
CORS_ORIGINS=http://localhost:5173

# Environment
APP_ENV=development
