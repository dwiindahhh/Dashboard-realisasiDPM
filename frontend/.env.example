# ── Frontend Environment Variables ──────────────────────────────────
# Salin file ini ke ".env.local" dan isi nilainya.
# File .env.local TIDAK boleh di-commit ke Git.

# URL API Backend (default: proxy Vite ke localhost:8000)
# Saat development, biarkan kosong — Vite proxy sudah handle otomatis.
# Saat production, isi dengan URL FastAPI yang sudah di-deploy.
VITE_API_URL=

# Mapbox token untuk peta choropleth (opsional di tahap awal)
VITE_MAPBOX_TOKEN=

# Environment label
VITE_APP_ENV=development
